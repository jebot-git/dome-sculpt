+/* Keep the pool while any generated function is live.  Once the last block
+ * is freed, u_mmFreeMem coalesces the entire heap into one free block.  Drop
+ * both the executable mapping and allocator metadata before the driver DSO
+ * can unload; a later allocation initializes a new pool under exec_mutex.
+ */
+static void
+release_empty_heap(void)
+{
+   if (exec_heap && exec_heap->next->free &&
+       exec_heap->next->next == exec_heap &&
+       exec_heap->next->size == EXEC_HEAP_SIZE) {
+      u_mmDestroy(exec_heap);
+      exec_heap = NULL;
+      munmap(exec_mem, EXEC_HEAP_SIZE);
+      exec_mem = NULL;
+   }
+}
