# Offline build-directory-only extraction of the pinned ArmorPaint function.
# Source/license: experiments/armorpaint-blur/vendor,629f8e77; zlib/libpng.
file(SHA256 "${SOURCE}" digest)
if(NOT digest STREQUAL "a2403c5ef2ffd23fc5a1798b47c04b29ecc9e5362faa8f16f20e4f842314fbf4")
  message(FATAL_ERROR "Pinned ArmorPaint blur source hash mismatch")
endif()
file(READ "${SOURCE}" text)
string(FIND "${text}" "char *str_get_blur_tool_weight" first)
if(first LESS 0)
  message(FATAL_ERROR "Pinned blur weight declaration missing")
endif()
string(SUBSTRING "${text}" ${first} -1 tail)
string(FIND "${tail}" "\n" begin)
string(FIND "${tail}" "\";" end)
math(EXPR begin "${begin}+1")
math(EXPR length "${end}-${begin}")
string(SUBSTRING "${tail}" ${begin} ${length} function)
string(REPLACE "\\\n" "\n" function "${function}")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}" "#pragma once\ninline constexpr char armorpaint_blur_weights[] = R\"shader(${function})shader\";\n")
